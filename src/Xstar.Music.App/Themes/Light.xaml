<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <!-- Light theme — semantic surfaces / text / borders -->
    <SolidColorBrush x:Key="BgCanvasBrush" Color="#F6F7FB"/>
    <SolidColorBrush x:Key="SurfaceBrush" Color="#FFFFFF"/>
    <SolidColorBrush x:Key="SurfaceAltBrush" Color="#FFFFFF"/>
    <SolidColorBrush x:Key="SunkenBrush" Color="#EEF0F6"/>
    <SolidColorBrush x:Key="ControlBrush" Color="#FFFFFF"/>

    <SolidColorBrush x:Key="BorderBrush" Color="#E4E7EF"/>
    <SolidColorBrush x:Key="BorderStrongBrush" Color="#C2C7D6"/>

    <SolidColorBrush x:Key="HoverBrush" Color="#0E000000"/>
    <SolidColorBrush x:Key="PressedBrush" Color="#1C000000"/>

    <SolidColorBrush x:Key="TextPrimaryBrush" Color="#17181C"/>
    <SolidColorBrush x:Key="TextSecondaryBrush" Color="#555B68"/>
    <SolidColorBrush x:Key="TextMutedBrush" Color="#8A90A0"/>

    <SolidColorBrush x:Key="TrackBrush" Color="#DFE3EE"/>
    <SolidColorBrush x:Key="DangerBrush" Color="#DC2626"/>
    <SolidColorBrush x:Key="ScrimBrush" Color="#7314141E"/>

    <!-- cover overlay text (always light-on-artwork) -->
    <SolidColorBrush x:Key="OnArtworkBrush" Color="#FFFFFF"/>
    <SolidColorBrush x:Key="OnArtworkSoftBrush" Color="#EBFFFFFF"/>
    <SolidColorBrush x:Key="OnArtworkChipBrush" Color="#66000000"/>
</ResourceDictionary>
