<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <!-- Fonts -->
    <FontFamily x:Key="AppFont">Segoe UI Variable Text, Segoe UI, Microsoft YaHei UI</FontFamily>
    <FontFamily x:Key="IconFont">Segoe Fluent Icons, Segoe MDL2 Assets</FontFamily>

    <!-- Corner radii -->
    <CornerRadius x:Key="RadiusSm">6</CornerRadius>
    <CornerRadius x:Key="RadiusMd">10</CornerRadius>
    <CornerRadius x:Key="RadiusLg">14</CornerRadius>
    <CornerRadius x:Key="RadiusXl">20</CornerRadius>
    <CornerRadius x:Key="RadiusPill">999</CornerRadius>
    <CornerRadius x:Key="RadiusCircular">9999</CornerRadius>

    <!-- Dynamic accent (mutated at runtime from cover colour; defaults to brand indigo) -->
    <SolidColorBrush x:Key="AccentBrush" Color="#6E8BFF"/>
    <SolidColorBrush x:Key="AccentHoverBrush" Color="#849CFF"/>
    <SolidColorBrush x:Key="AccentPressedBrush" Color="#5A77EE"/>
    <SolidColorBrush x:Key="OnAccentBrush" Color="#FFFFFF"/>
    <SolidColorBrush x:Key="AccentSubtleBrush" Color="#266E8BFF"/>
    <SolidColorBrush x:Key="AccentGlowBrush" Color="#806E8BFF"/>

    <!-- Constant semantics -->
    <SolidColorBrush x:Key="FavoriteBrush" Color="#F06A9A"/>

    <BooleanToVisibilityConverter x:Key="BoolToVis"/>
</ResourceDictionary>
